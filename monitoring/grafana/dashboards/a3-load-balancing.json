 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "HTTP: per replica (rates and quantiles use a 1 minute window)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP request rate per replica",
   "description": "Requests per second answered by each replica. Source: the replica's own /metrics, scraped directly. rate() over 1m.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (replica) (rate(campus_http_requests_total[1m]))",
     "legendFormat": "{{replica}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "equal share.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "HTTP share of total traffic",
   "description": "Each replica's percentage of all requests (1m window). Dashed line = equal share of three replicas.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (replica) (rate(campus_http_requests_total[1m])) / scalar(sum(rate(campus_http_requests_total[1m])))",
     "legendFormat": "{{replica}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(100/3)",
     "legendFormat": "equal share (33.3%)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "spanNulls": false
     },
     "min": 0,
     "max": 100
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "equal share.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
