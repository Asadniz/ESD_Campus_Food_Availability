  {
   "id": 16,
   "type": "timeseries",
   "title": "Healthy members per cluster",
   "description": "Replicas Envoy currently sends traffic to. Drops after unhealthy_threshold x interval when a replica stops.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
